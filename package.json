{
  "name": "@melaninmap/webmcp-consent",
  "version": "1.0.0",
  "description": "A consent gate for WebMCP tools: consequential agent tool calls suspend until a human confirms in the page.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "schemas",
    "examples/*.ts",
    "examples/*.css",
    "reference",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "TRADEMARKS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/A-Technologies-Holdings/melaninmap-webmcp/issues",
  "homepage": "https://github.com/A-Technologies-Holdings/melaninmap-webmcp#readme",
  "keywords": [
    "webmcp",
    "mcp",
    "model-context",
    "agent",
    "consent",
    "human-in-the-loop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-Technologies-Holdings/melaninmap-webmcp.git"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "build:test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "pretest": "npm run build && npm run build:test",
    "test": "node --test",
    "check:contract": "node scripts/check-contract-matches-reference.mjs",
    "check:openapi": "node scripts/check-openapi-pointers.mjs",
    "check:pack": "publint && attw --pack . --profile esm-only",
    "check": "npm run typecheck && npm run check:contract && npm run check:openapi && npm run build && npm run build:test && node --test && npm run check:pack",
    "test:browser": "npm run build && npm run build:test && playwright test",
    "check:spec": "node scripts/check-spec-drift.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.63.0",
    "@typescript/typescript6": "6.0.2",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "webidl2": "24.5.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas/tools": "./schemas/melaninmap.tools.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
